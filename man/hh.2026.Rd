\name{hh.2026}
\alias{hh.2026}
\docType{data}
\title{Information about heads harvested from p1, p2, p6, p7, p8, p9, and tplot in 2026}
\format{A 263 x 10 dataframe.} 
\usage{hh.2026}
%%   ~~ data name/kind ... ~~

\description{  This data frame contains harvest information on heads
  harvested from p1, p2, and p8 in 2026. There are a total of 263 records. 
  In p2 in 2026, hds on the same plant were harvested together
  under the same letNo/cgHdId and did not have tts.
  This data frame was generated by the script 
  make.hh2026.R, which is saved in 
  ~Dropbox/CGData/140_reconcile/reconcile2026/reconcileWork.
  The records come from the reconciled harvest list in 
  ~Dropbox/CGData/140_reconcile/reconcile2026/reconcileOut.
%%  ~~ A concise (1-5 lines) description of the dataset. ~~
}


\section{Variables}{
  Variables: \itemize{ 
    \item gBag, the grocery bag in which harvester placed head
    \item row, row of common garden head(s) was collected from
    \item tt, twist-tie color (blank in p2)
    \item cgHdId, unique identifier for head(s)
    \item batch, experiment name for head(s)
    \item block, we used to use this to prioritize cleaning within experiments
    \item lineNo, line of paper harvest datasheet for head(s)
    \item No, the four digit unique identifier
    \item pos, position in row of common garden of head(s)
    \item letno, unique identifier for head(s)}
}

\examples{
  dim(hh.2026)
  str(hh.2026)
  
  table(hh.2026$batch)
  
  # plot of heads harvested in p1 & 99s
  plot(pos ~ row, hh.2026[hh.2026$pos > 800,], asp = 1)
  
  # plot of heads harvested in p8 
  plot(pos ~ row, hh.2026[hh.2026$pos < 800 & hh.2026$pos > 600 , ], asp = 1)
  
   # plot of heads harvested in p2, p7, and p9
  plot(pos ~ row, hh.2026[hh.2026$pos < 600, ], asp = 1)
}
\keyword{datasets}
